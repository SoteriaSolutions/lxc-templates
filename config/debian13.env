# Source Debian LXC image in Proxmox storage.
IMAGE_STORAGE="SAS"
IMAGE_ARCHIVE="debian-13-standard_13.6-1_amd64.tar.zst"

# Storage used for the build container's root filesystem.
ROOTFS_STORAGE="NVMe"

# Debian template configuration.
ROOTFS_SIZE_GB="8"
CORES="2"
MEMORY_MB="1024"
SWAP_MB="512"

# Networking matches the existing Debian LXC environment.
NETWORK_BRIDGE="vmbr0"
NETWORK_VLAN="110"

# Template bootstrap identity.
ANSIBLE_UID="3700"
